# Personal AI Agent configuration.
# Export values in your shell environment to override defaults.

PAI_CHAT_MODEL=qwen3:8b
PAI_EMBEDDING_MODEL=embeddinggemma:300m-qat-q4_0
PAI_MAX_TOOL_ROUNDS=8
PAI_SESSION_HISTORY_LIMIT=100

PAI_KNOWLEDGE_CHUNK_SIZE=1400
PAI_KNOWLEDGE_CHUNK_OVERLAP=200
PAI_KNOWLEDGE_EMBED_BATCH_SIZE=24
PAI_KNOWLEDGE_MAX_TOP_K=10
PAI_KNOWLEDGE_MAX_RESULT_CHARS=2200
PAI_KNOWLEDGE_MAX_FILE_BYTES=25000000

PAI_WEB_HOST=127.0.0.1
PAI_WEB_PORT=8000
PAI_WEB_MAX_UPLOAD_BYTES=25000000

# Optional absolute-path overrides:
# PAI_WORKSPACE_ROOT=/path/to/workspace
# PAI_KNOWLEDGE_ROOT=/path/to/knowledge
