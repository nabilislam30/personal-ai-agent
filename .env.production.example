# Copy to .env.production and replace the generated values.
# Never commit .env.production.

PAI_ENV=production
PAI_REQUIRE_AUTH=true

# Generate both values with:
# python scripts/generate_auth.py
PAI_PASSWORD_HASH=REPLACE_WITH_GENERATED_HASH
PAI_SECRET_KEY=REPLACE_WITH_GENERATED_SECRET

# Set true when accessing the service through HTTPS, including Tailscale Serve.
PAI_COOKIE_SECURE=true

PAI_CHAT_MODEL=qwen3:8b
PAI_EMBEDDING_MODEL=embeddinggemma:300m-qat-q4_0
PAI_OLLAMA_KEEP_ALIVE=30m
PAI_PRELOAD_MODEL=true

PAI_SIMPLE_CHAT_HISTORY_LIMIT=12
PAI_TOOL_HISTORY_LIMIT=24
PAI_SESSION_SUMMARY_MAX_CHARS=6000

PAI_CHAT_RATE_LIMIT_PER_MINUTE=30
PAI_LOGIN_RATE_LIMIT_PER_MINUTE=10
PAI_WEB_MAX_UPLOAD_BYTES=25000000
